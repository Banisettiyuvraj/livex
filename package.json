{
  "name": "livex",
  "version": "1.4.0",
  "private": true,
  "description": "LiveX - a local-first simulated live session video player. Videos never leave your device.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:build": "node tests/build-check.mjs",
    "verify": "npm run build && npm run test:build",
    "test:e2e": "playwright test",
    "test:features": "playwright test tests/e2e/features.spec.ts",
    "test:features2": "playwright test tests/e2e/features.spec.ts --grep \"Part 2\"",
    "test:all": "npm run test:unit && npm run test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "audit:compat": "node tools/audit-compatibility.mjs",
    "audit:dom": "node tools/check-dom-ids.mjs",
    "audit": "npm run audit:compat && npm run audit:dom",
    "verify:youtube": "node tools/verify-youtube.mjs"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "playwright": "^1.65.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
