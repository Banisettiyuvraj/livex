{
  "name": "livex",
  "version": "1.3.0",
  "private": true,
  "description": "LiveX - a local-first simulated live session video player. Videos never leave your device.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node tests/e2e.mjs",
    "test:build": "node tests/build-check.mjs",
    "verify": "npm run build && npm run test:build",
    "test:features": "node tests/features.mjs",
    "test:all": "node tests/e2e.mjs && node tests/features.mjs"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "autoprefixer": "^10.6.2",
    "playwright": "^1.65.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
